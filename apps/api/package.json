{
  "name": "@dosly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dosly/core": "workspace:*",
    "@dosly/db": "workspace:*",
    "@dosly/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "bullmq": "6.7.8",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": { "tsx": "4.23.15", "vitest": "5.1.1" }
}
