// Dosly data model. Every tenant-owned row carries agencyId; the API scopes every query by it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  MODERATOR
  WRITER
}

model Agency {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  demoExpiresAt DateTime? // set only on demo sandboxes; the worker deletes them after this
  plan        PlanTier @default(TRIAL)
  trialEndsAt DateTime?
  paidUntil   DateTime?
  status      AgencyStatus @default(ACTIVE)
  suspendedReason String?
  payments    Payment[]
  memberships Membership[]
  clients     Client[]
  waNumbers   WhatsAppNumber[]
  contacts    Contact[]
  conversations Conversation[]
  messages    Message[]
  quickReplies QuickReply[]
  waTemplates WaTemplate[]
  socialComments SocialComment[]
  socialAccounts SocialAccount[]
  adAccounts  AdAccount[]
  adAlerts    AdAlert[]
  stores      StoreConnection[]
  orders      StoreOrder[]
  billing     AgencyBilling?
  packages    ServicePackage[]
  subscriptions ClientSubscription[]
  invoices    Invoice[]
  invoicePayments InvoicePayment[]
  broadcasts  Broadcast[]
  posts       Post[]
  auditLogs   AuditLog[]
  invites     Invite[]

  @@index([demoExpiresAt])
  @@index([createdAt])
}

enum PlanTier {
  TRIAL
  STARTER
  GROWTH
  AGENCY
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED // read-only: the agency can look but not send or publish
}

/// A payment recorded by a Dosly admin (InstaPay or bank transfer until online payments exist).
model Payment {
  id           String   @id @default(cuid())
  agencyId     String
  plan         PlanTier
  amountEgp    Int
  months       Int
  method       String
  reference    String?
  recordedById String
  createdAt    DateTime @default(now())
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
}

/// Dosly staff. Separate from agency users: own table, own sessions, password + TOTP code.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  totpSecretEnc String  // AES-256-GCM, like Meta tokens
  createdAt    DateTime @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id // sha256 of the cookie token
  adminId   String
  readOnly  Boolean  @default(false) // demo visitors look around but change nothing
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  memberships  Membership[]
  sessions     Session[]
  assignments  ClientAssignment[]
  assignedConversations Conversation[] @relation("assignee")
  sentMessages Message[]
  sentComments SocialComment[]
  createdPosts Post[] @relation("postAuthor")
  approvedPosts Post[] @relation("postApprover")
  orderFollowUps StoreOrder[] @relation("orderFollowUp")
  createdInvoices Invoice[]
  createdBroadcasts Broadcast[]
}

model Membership {
  id        String   @id @default(cuid())
  agencyId  String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
}

model Invite {
  id        String   @id @default(cuid())
  agencyId  String
  email     String
  role      Role
  tokenHash String   @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model Session {
  id        String   @id // sha256 of the cookie token, never the token itself
  userId    String
  agencyId  String
  expiresAt DateTime
  impersonatorId String? // a Dosly admin signed in as this user for support; such sessions cannot send or publish
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignments ClientAssignment[]
  waNumbers   WhatsAppNumber[]
  contacts    Contact[]
  conversations Conversation[]
  socialAccounts SocialAccount[]
  posts       Post[]
  portalUsers ClientUser[]
  socialComments SocialComment[]
  adAccounts  AdAccount[]
  adAlerts    AdAlert[]
  stores      StoreConnection[]
  orders      StoreOrder[]
  subscriptions ClientSubscription[]
  invoices    Invoice[]
  broadcasts  Broadcast[]
  legalName   String?  // the name on the client's invoices, when it differs from the display name
  taxId       String?  // the client's tax registration number (رقم التسجيل الضريبي), for B2B invoices
  billingAddress String?
  requiresClientApproval Boolean @default(false) // posts wait for the client's OK in the portal before publishing
  showAdsInPortal Boolean @default(false) // the client sees ad spend and results in the portal report (the agency opts in)

  @@index([agencyId])
}

/// A person on the agency's client side (the business owner). Signs in to the portal only,
/// with separate sessions, and never sees the agency dashboard.
model ClientUser {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String
  email       String
  name        String
  createdAt   DateTime @default(now())
  lastLoginAt DateTime?
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions    ClientSession[]
  loginTokens ClientLoginToken[]

  @@unique([clientId, email])
  @@index([agencyId])
}

model ClientSession {
  id           String   @id // sha256 of the cookie token
  clientUserId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  @@index([clientUserId])
}

/// One-time sign-in link for the portal (no passwords for business owners).
model ClientLoginToken {
  id           String   @id // sha256 of the token in the link
  clientUserId String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  @@index([clientUserId])
}

model ClientAssignment {
  clientId String
  userId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model WhatsAppNumber {
  id             String   @id @default(cuid())
  agencyId       String
  clientId       String
  phoneNumberId  String   @unique // Meta phone_number_id, the webhook routing key
  wabaId         String
  displayPhone   String
  verifiedName   String?
  accessTokenEnc String   // AES-256-GCM, see @dosly/shared crypto
  status         ChannelStatus @default(CONNECTED)
  createdAt      DateTime @default(now())
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  contacts       Contact[]
  templates      WaTemplate[]
  templatesSyncedAt DateTime?
  stores         StoreConnection[]
  broadcasts     Broadcast[]

  @@index([agencyId])
}

model Contact {
  id              String   @id @default(cuid())
  agencyId        String
  clientId        String
  waNumberId      String?
  socialAccountId String?
  waId            String?  // WhatsApp: the customer's number in E.164 without +
  externalId      String?  // Messenger PSID or Instagram-scoped id
  username        String?  // Instagram @handle
  avatarUrl       String?
  name            String?
  adId            String?  // Click-to-WhatsApp: the Meta ad the customer first came from (webhook referral.source_id)
  adReferredAt    DateTime?
  marketingOptOutAt DateTime? // asked for no more offers (wrote "إيقاف", pressed the stop button, or Meta reported 131050)
  createdAt       DateTime @default(now())
  broadcasts      BroadcastRecipient[]
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  waNumber        WhatsAppNumber? @relation(fields: [waNumberId], references: [id], onDelete: Cascade)
  orders          StoreOrder[]
  socialAccount   SocialAccount?  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  conversations   Conversation[]

  @@unique([waNumberId, waId])
  @@unique([socialAccountId, externalId])
  @@index([clientId, waId])
}

/** Where a conversation happens. Comments live in SocialComment, not here. */
enum Channel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model Conversation {
  id             String   @id @default(cuid())
  agencyId       String
  clientId       String
  channel        Channel  @default(WHATSAPP)
  waNumberId     String?
  socialAccountId String?
  contactId      String
  status         ConversationStatus @default(OPEN)
  assigneeId     String?
  unreadCount    Int      @default(0)
  lastMessageAt  DateTime @default(now())
  lastInboundAt  DateTime? // free-form replies are allowed within 24h of this (Messenger/Instagram: 7 days with the human agent tag)
  lastPreview    String?
  createdAt      DateTime @default(now())
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  waNumber       WhatsAppNumber? @relation(fields: [waNumberId], references: [id], onDelete: Cascade)
  socialAccount  SocialAccount?  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee       User?    @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([waNumberId, contactId])
  @@unique([socialAccountId, contactId])
  @@index([agencyId, lastMessageAt])
}

enum Direction {
  IN
  OUT
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id             String   @id @default(cuid())
  agencyId       String
  conversationId String
  direction      Direction
  type           String   // text, image, audio, video, document, sticker, template, location, ...
  body           String?  // text, media caption, or the rendered template body
  mediaId        String?  // Meta media id: inbound ones expire after 7 days, uploaded ones after 30
  mediaStatus    MediaStatus?
  mediaKey       String?  // private storage key of the original file
  previewKey     String?  // image/sticker: webp thumbnail; video: jpg poster; audio: m4a for browsers without Ogg
  mediaMime      String?
  mediaSize      Int?
  mediaSha256    String?
  fileName       String?
  mediaWidth     Int?
  mediaHeight    Int?
  durationSec    Float?
  voice          Boolean  @default(false) // a WhatsApp voice note (OGG/OPUS mono), not an audio file
  payload        Json?    // outbound: what the worker sends (template components, media options)
  waMessageId    String?  @unique // the platform's message id: WhatsApp wamid or Messenger/Instagram mid
  status         MessageStatus
  error          String?
  sentById       String?
  createdAt      DateTime @default(now())
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy         User?    @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([mediaStatus, createdAt])
}

enum MediaStatus {
  PENDING  // inbound: waiting for the worker to download it from Meta
  READY
  FAILED
}

/** WhatsApp message templates, synced per number from its WhatsApp Business Account. */
model WaTemplate {
  id              String   @id @default(cuid())
  agencyId        String
  waNumberId      String
  metaId          String
  name            String
  language        String
  category        String   // MARKETING | UTILITY | AUTHENTICATION
  status          String   // APPROVED | PENDING | REJECTED | PAUSED | DISABLED | ...
  parameterFormat String   @default("POSITIONAL") // or NAMED
  components      Json
  reason          String?
  syncedAt        DateTime @default(now())
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  waNumber        WhatsAppNumber @relation(fields: [waNumberId], references: [id], onDelete: Cascade)

  @@unique([waNumberId, name, language])
  @@index([metaId])
}

model QuickReply {
  id        String   @id @default(cuid())
  agencyId  String
  shortcut  String
  body      String
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, shortcut])
}

enum Platform {
  FACEBOOK_PAGE
  INSTAGRAM
}

model SocialAccount {
  id             String   @id @default(cuid())
  agencyId       String
  clientId       String
  platform       Platform
  externalId     String   // Page id or Instagram professional account id
  name           String
  accessTokenEnc String
  status         ChannelStatus @default(CONNECTED)
  createdAt      DateTime @default(now())
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targets        PostTarget[]
  contacts       Contact[]
  conversations  Conversation[]
  comments       SocialComment[]

  @@unique([agencyId, platform, externalId])
  @@index([platform, externalId]) // webhook routing
}

enum CommentStatus {
  OPEN   // needs an answer or a decision
  DONE   // answered, hidden, or marked handled
}

/**
 * Comments on the client's Facebook and Instagram posts, including the agency's own replies
 * (fromPage = true). Threads: a reply points at its parent through parentExternalId.
 */
model SocialComment {
  id                String   @id @default(cuid())
  agencyId          String
  clientId          String
  socialAccountId   String
  platform          Platform
  externalId        String   // Graph comment id
  postExternalId    String   // the post or media it is on
  parentExternalId  String?  // set on replies
  authorId          String?
  authorName        String?
  body              String
  fromPage          Boolean  @default(false)
  sentById          String?
  status            CommentStatus @default(OPEN)
  isHidden          Boolean  @default(false)
  deletedAt         DateTime?
  privateReplyAt    DateTime? // Meta allows one private message per comment, within 7 days
  privateConversationId String? // the inbox conversation that private reply opened
  createdAt         DateTime @default(now())
  agency            Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialAccount     SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  sentBy            User?    @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@unique([socialAccountId, externalId])
  @@index([agencyId, status, createdAt])
  @@index([socialAccountId, postExternalId, createdAt])
}

enum ClientReview {
  NOT_REQUIRED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
}

model Post {
  id           String   @id @default(cuid())
  agencyId     String
  clientId     String
  createdById  String
  approvedById String?
  caption      String
  mediaUrls    String[]
  scheduledAt  DateTime?
  status       PostStatus @default(DRAFT)
  clientReview ClientReview @default(NOT_REQUIRED)
  clientNote   String?  // what the client asked to change
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("postAuthor", fields: [createdById], references: [id])
  approvedBy   User?    @relation("postApprover", fields: [approvedById], references: [id])
  targets      PostTarget[]

  @@index([agencyId, scheduledAt])
  @@index([clientId, scheduledAt])
}

enum TargetStatus {
  PENDING
  PUBLISHED
  FAILED
}

model PostTarget {
  id              String   @id @default(cuid())
  postId          String
  socialAccountId String
  status          TargetStatus @default(PENDING)
  externalPostId  String?
  error           String?
  attempts        Int      @default(0)
  publishedAt     DateTime?
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
}

model AuditLog {
  id        String   @id @default(cuid())
  agencyId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  source      String   // meta, demo, store
  dedupeKey   String?  @unique // the sender's delivery id (Shopify X-Shopify-Webhook-Id), so a retried delivery is stored once
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  error       String?
}

/**
 * A Meta ad account the agency runs for a client, read through the Marketing API (ads_read).
 * Money is stored in the currency's minor unit (Meta's "offset": 100 for EGP and USD), as integers.
 */
model AdAccount {
  id               String   @id @default(cuid())
  agencyId         String
  clientId         String
  externalId       String   // numeric ad account id, without the act_ prefix
  name             String
  currency         String   // ISO 4217, as set on the ad account
  timezoneName     String   // insights dates are days in this time zone
  accountStatus    Int      @default(1) // Meta account_status: 1 active, 2 disabled, 3 unsettled, ...
  disableReason    Int      @default(0)
  spendCapMinor    BigInt?  // account spending limit; null when none
  amountSpentMinor BigInt   @default(0) // spent against the spending limit
  accessTokenEnc   String
  status           ChannelStatus @default(CONNECTED) // ERROR: the token stopped working; sync paused until reconnect
  lastError        String?
  lastSyncAt       DateTime?
  insightsFrom     String?  // first day synced (YYYY-MM-DD)
  throttledUntil   DateTime? // Meta asked us to slow down; no calls before this
  lastAttemptAt    DateTime? // last try, good or bad: a failing account waits a full interval too
  createdAt        DateTime @default(now())
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaigns        AdCampaign[]
  alerts           AdAlert[]
  ads              AdAd[]

  @@unique([agencyId, externalId])
  @@index([clientId])
  @@index([status, lastSyncAt])
}

model AdCampaign {
  id                  String   @id @default(cuid())
  adAccountId         String
  externalId          String
  name                String
  objective           String?  // OUTCOME_SALES, OUTCOME_LEADS, ...
  status              String   // configured: ACTIVE, PAUSED, DELETED, ARCHIVED
  effectiveStatus     String   // ACTIVE, PAUSED, WITH_ISSUES, IN_PROCESS, ...
  dailyBudgetMinor    BigInt?  // set only when the budget is on the campaign (not its ad sets)
  lifetimeBudgetMinor BigInt?
  budgetRemainingMinor BigInt?
  checkedStatus       String?  // effectiveStatus when alerts were last evaluated: a change from delivering opens "stopped"
  issues              Json?    // issues_info: why it is not delivering
  startTime           DateTime?
  stopTime            DateTime?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
  adAccount           AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  insights            AdInsightDaily[]
  alerts              AdAlert[]
  ads                 AdAd[]
  orders              StoreOrder[]

  @@unique([adAccountId, externalId])
}

/** One campaign on one day (the ad account's time zone). Meta keeps changing a day for 28 days, so those are re-read. */
model AdInsightDaily {
  campaignId         String
  date               String   // YYYY-MM-DD
  spendMinor         BigInt   @default(0)
  impressions        Int      @default(0)
  reach              Int      @default(0)
  linkClicks         Int      @default(0)
  messages           Int      @default(0) // messaging conversations started
  leads              Int      @default(0)
  purchases          Int      @default(0)
  purchaseValueMinor BigInt   @default(0)
  campaign           AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, date])
  @@index([date])
}

enum AdAlertKind {
  ACCOUNT_PROBLEM   // disabled, unpaid bill, under review: nothing delivers
  SPEND_CAP_NEAR    // the account spending limit is almost reached
  CAMPAIGN_ISSUES   // Meta stopped delivery (WITH_ISSUES or issues_info)
  CAMPAIGN_STOPPED  // was running at the last check and is not running now
  BUDGET_LOW        // a lifetime budget is almost spent
}

/** One open problem per account or campaign and kind. It resolves itself when the condition clears. */
model AdAlert {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String
  adAccountId String
  campaignId  String?
  kind        AdAlertKind
  objectKey   String   // the account or campaign id it is about, so one row per problem
  detail      Json?
  openedAt    DateTime @default(now())
  resolvedAt  DateTime?
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign    AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, kind, objectKey])
  @@index([agencyId, resolvedAt])
}

/** Which ad an ad id belongs to, so a Click-to-WhatsApp customer (who brings an ad id) counts for the right campaign. */
model AdAd {
  adAccountId String
  externalId  String   // Meta ad id
  campaignId  String
  adAccount   AdAccount  @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([adAccountId, externalId])
  @@index([externalId])
}

enum StoreKind {
  EASYORDERS
  SHOPIFY
}

/**
 * A client's online store. The store sends its orders to /webhooks/store/{hookId}; the request is
 * checked with the store's secret (EasyOrders: the `secret` header; Shopify: an HMAC of the body).
 */
model StoreConnection {
  id               String    @id @default(cuid())
  agencyId         String
  clientId         String
  kind             StoreKind
  name             String
  hookId           String    @unique // random, in the webhook URL: routes a delivery to this store
  secretEnc        String?   // AES-256-GCM; null until the owner pastes the secret the store shows
  currency         String    @default("EGP")
  status           ChannelStatus @default(CONNECTED)
  lastOrderAt      DateTime?
  lastError        String?
  autoConfirm      Boolean   @default(true) // cash-on-delivery orders get a WhatsApp confirmation
  waNumberId       String?   // the number that sends confirmations; null = the client's first number
  confirmTemplate  String?   // template name; null = the first approved one that fits
  confirmWaitMin   Int       @default(120) // no answer after this long: a moderator calls
  createdAt        DateTime  @default(now())
  agency           Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  waNumber         WhatsAppNumber? @relation(fields: [waNumberId], references: [id], onDelete: SetNull)
  orders           StoreOrder[]

  @@index([agencyId])
  @@index([clientId])
}

/** Where an order is, in words every store shares. The store's own word is kept in rawStatus. */
enum OrderStatus {
  PENDING     // new, not confirmed yet
  CONFIRMED
  PROCESSING  // being prepared
  SHIPPED     // with the courier
  DELIVERED
  CANCELLED
  RETURNED
  FAILED
}

/** The WhatsApp confirmation of a cash-on-delivery order. */
enum ConfirmState {
  NONE       // not needed: paid online, or not a new order
  SENT       // waiting for the customer to press a button
  CONFIRMED  // the customer (or the agency on the phone, or the store) confirmed it
  DECLINED   // the customer pressed cancel
  NO_ANSWER  // no answer in time: a moderator calls
  NOT_SENT   // could not send (no number, no approved template, bad phone, or Meta refused)
}

model StoreOrder {
  id              String    @id @default(cuid())
  agencyId        String
  clientId        String
  storeId         String
  externalId      String
  number          String    // what the store shows: #1001, or the start of an EasyOrders id
  status          OrderStatus @default(PENDING)
  rawStatus       String?
  cod             Boolean   @default(true)
  paymentMethod   String?
  currency        String
  totalMinor      BigInt    @default(0) // piastres / cents
  shippingMinor   BigInt    @default(0)
  customerName    String?
  phone           String?   // as the customer typed it
  waId            String?   // the phone as a WhatsApp id (E.164 without +), for matching the inbox
  city            String?
  address         String?
  items           Json      // [{ name, variant, qty, priceMinor }]
  trackingNumber  String?
  trackingCompany String?
  trackingUrl     String?
  shipmentStatus  String?   // Shopify fulfillment shipment_status: in_transit, out_for_delivery, delivered, ...
  utmSource       String?
  utmCampaign     String?
  fbclid          String?
  campaignId      String?   // the ad campaign this sale came from, when we can tell
  attribution     String?   // utm | whatsapp_ad
  contactId       String?
  confirm         ConfirmState @default(NONE)
  confirmMessageId String?  // our template message
  confirmSentAt   DateTime?
  confirmedAt     DateTime?
  confirmedBy     String?   // customer | agent | store
  confirmError    String?
  followUpDoneAt  DateTime? // a moderator dealt with a flagged order
  followUpById    String?
  placedAt        DateTime
  sourceUpdatedAt DateTime? // the store's own updated_at: an older delivery never overwrites a newer one
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  store           StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign        AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  followUpBy      User?     @relation("orderFollowUp", fields: [followUpById], references: [id], onDelete: SetNull)

  @@unique([storeId, externalId])
  @@index([clientId, placedAt])
  @@index([agencyId, confirm])
  @@index([confirm, confirmSentAt])
  @@index([contactId])
  @@index([confirmMessageId])
  @@index([clientId, waId])
}

/**
 * How the agency bills its own clients: the seller details printed on its invoices, VAT, numbering
 * and the ways its clients can pay (Egypt: InstaPay, mobile wallets, bank transfer; no card gateway yet).
 */
model AgencyBilling {
  agencyId        String   @id
  legalName       String?
  taxId           String?  // رقم التسجيل الضريبي: 9 digits
  commercialReg   String?  // رقم السجل التجاري
  address         String?
  phone           String?
  vatRegistered   Boolean  @default(false)
  vatRateBp       Int      @default(1400) // basis points: 1400 = 14%, Egypt's standard rate
  invoicePrefix   String   @default("INV")
  nextNumber      Int      @default(1) // the next issued invoice gets this sequence number; only ever goes up
  dueDays         Int      @default(7)
  autoIssue       Boolean  @default(true) // recurring invoices go straight to the client; false = they wait as drafts
  instapay        String?  // InstaPay address (name@instapay) or the mobile number linked to it
  instapayLink    String?  // https://ipn.eg/S/... link from the InstaPay app
  wallet          String?  // mobile wallet number (Vodafone Cash, Etisalat Cash, ...)
  walletName      String?  // the name the wallet is registered under, so the client can check before sending
  bankName        String?
  bankAccountName String?
  iban            String?
  paypalLink      String?  // https://paypal.me/... for clients abroad
  payNote         String?  // free text shown under the payment methods
  updatedAt       DateTime @updatedAt
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

/** A service package the agency sells, e.g. "12 posts + inbox management" for 6,000 EGP a month. */
model ServicePackage {
  id            String   @id @default(cuid())
  agencyId      String
  name          String
  description   String?
  features      String[] // what the client gets, one line each
  priceMinor    Int      // piastres; a single invoice line is capped well below Int range
  currency      String   @default("EGP")
  months        Int      @default(1) // billing period: 1, 3, 6 or 12; 0 = one-time
  postsPerMonth Int?
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscriptions ClientSubscription[]

  @@index([agencyId])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED  // no new invoices until resumed
  ENDED
}

/**
 * A client on a package. Name, price and period are copied from the package when it starts, so
 * changing a package later never changes what an existing client pays. Periods are counted from
 * startOn (cycle n starts startOn + n * months), so a start on the 31st stays at month end.
 */
model ClientSubscription {
  id            String   @id @default(cuid())
  agencyId      String
  clientId      String
  packageId     String?
  name          String
  priceMinor    Int
  currency      String   @default("EGP")
  months        Int      // >= 1
  startOn       String   // YYYY-MM-DD, Cairo
  cycles        Int      @default(0) // periods already invoiced
  nextInvoiceOn String?  // YYYY-MM-DD the next period starts and is invoiced; null when ended
  status        SubscriptionStatus @default(ACTIVE)
  endedAt       DateTime?
  createdAt     DateTime @default(now())
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package       ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  invoices      Invoice[]

  @@index([status, nextInvoiceOn])
  @@index([clientId])
  @@index([agencyId])
}

enum InvoiceStatus {
  DRAFT   // only the agency sees it; no number yet
  ISSUED  // numbered and visible to the client; unpaid or partly paid (overdue = past dueOn)
  PAID
  VOID    // cancelled after issue; keeps its number so the sequence has no holes
}

/**
 * An invoice from the agency to one of its clients. Money is in minor units (piastres). Once issued
 * the lines, totals and both parties' details are frozen; only payments and the ETA id change.
 */
model Invoice {
  id             String   @id @default(cuid())
  agencyId       String
  clientId       String
  subscriptionId String?
  seq            Int?     // per agency, assigned at issue
  number         String?  // prefix-year-seq, e.g. INV-2026-0007
  status         InvoiceStatus @default(DRAFT)
  currency       String   @default("EGP")
  issueOn        String?  // YYYY-MM-DD, Cairo
  dueOn          String?
  periodFrom     String?  // the service period a package invoice covers
  periodTo       String?
  items          Json     // [{ description, qty, unitMinor }]
  subtotalMinor  Int
  discountMinor  Int      @default(0)
  vatRateBp      Int      @default(0)
  vatMinor       Int      @default(0)
  totalMinor     Int
  paidMinor      Int      @default(0) // sum of confirmed payments
  notes          String?
  seller         Json?    // AgencyBilling snapshot at issue
  buyer          Json?    // client name, legal name, tax id, address at issue
  etaUuid        String?  // the UUID the Egyptian Tax Authority gave this invoice, pasted after submitting it there
  issuedAt       DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  voidReason     String?
  viewedAt       DateTime? // the client first opened it in the portal
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription   ClientSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments       InvoicePayment[]

  @@unique([agencyId, seq])
  @@unique([subscriptionId, periodFrom]) // one invoice per package period, even if the job runs twice
  @@index([agencyId, status, dueOn])
  @@index([clientId, createdAt])
}

enum PaymentState {
  PENDING    // the client says they paid; the agency has not checked yet
  CONFIRMED
  REJECTED
}

/** Money received against an invoice: recorded by the agency, or reported by the client and then checked. */
model InvoicePayment {
  id           String   @id @default(cuid())
  agencyId     String
  invoiceId    String
  amountMinor  Int
  method       String   // INSTAPAY | WALLET | BANK | CASH | PAYPAL | OTHER
  reference    String?  // transfer reference or the sender's number/name
  paidOn       String   // YYYY-MM-DD
  state        PaymentState @default(CONFIRMED)
  reportedBy   String   // agency | client
  clientUserId String?
  recordedById String?
  note         String?
  decidedAt    DateTime?
  createdAt    DateTime @default(now())
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([agencyId, state])
}

// ---------- WhatsApp broadcasts ----------

enum BroadcastStatus {
  SCHEDULED // waiting for its time
  SENDING
  DONE
  CANCELLED
}

/** One approved template sent to a chosen audience of a client's customers on one number. */
model Broadcast {
  id            String   @id @default(cuid())
  agencyId      String
  clientId      String
  waNumberId    String
  name          String
  templateName  String
  language      String
  category      String   // MARKETING | UTILITY: marketing is limited per person by Meta and costs more
  template      Json     // snapshot of the template's parameterFormat + components when it was chosen
  values        Json     // field id -> text; "[الاسم]" becomes each customer's first name
  audience      Json     // { kind, days? } see @dosly/shared broadcastAudienceSchema
  headerKey     String?  // private storage key of the header image
  headerMediaId String?  // Meta media id of that image, uploaded once per broadcast
  headerUploadedAt DateTime?
  status        BroadcastStatus @default(SCHEDULED)
  scheduledAt   DateTime
  startedAt     DateTime?
  finishedAt    DateTime?
  total         Int      @default(0) // people picked when sending started
  audienceAt    DateTime? // set once every recipient row is in, so a crash mid-pick resumes the pick
  createdById   String?
  createdAt     DateTime @default(now())
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  waNumber      WhatsAppNumber @relation(fields: [waNumberId], references: [id], onDelete: Cascade)
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients    BroadcastRecipient[]

  @@index([agencyId, createdAt])
  @@index([status, scheduledAt])
}

enum RecipientState {
  PENDING  // not sent yet
  SENT     // handed to WhatsApp; delivery and reads come from the message's status
  SKIPPED  // opted out after the audience was picked
  FAILED
}

model BroadcastRecipient {
  id          String   @id @default(cuid())
  broadcastId String
  contactId   String
  messageId   String?  @unique
  state       RecipientState @default(PENDING)
  attempts    Int      @default(0)
  lockedUntil DateTime? // a sender holds the row while sending it, so two runs never send to the same person
  error       String?
  errorCode   Int?
  sentAt      DateTime?
  repliedAt   DateTime?
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([broadcastId, state])
  @@index([contactId, sentAt])
}
