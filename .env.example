# Copy to .env and fill in. Never commit .env.

# Your domain, pointed at the VPS IP with an A record (and n8n.<domain> too).
DOMAIN=app.example.com
ACME_EMAIL=you@example.com
PUBLIC_URL=https://app.example.com

# Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
N8N_ENCRYPTION_KEY=

# Demo mode: Meta is fully simulated, the login page shows "try the demo", and the
# Meta values below can stay empty. Never turn it on for real agencies.
DEMO_MODE=false
# Seconds between simulated customer messages in active demo sandboxes (0 = off)
DEMO_AMBIENT_SECONDS=120

# From the Meta app: App settings > Basic > App ID and App secret
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value in the Meta webhook settings
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0

# Set to false once your agencies have accounts, to close public sign-up
ALLOW_SIGNUP=true
WORKER_CONCURRENCY=8

# AI assistant (Egyptian Arabic replies). Without a key, and always in demo mode, a simulated assistant answers.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
